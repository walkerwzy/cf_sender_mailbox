{
  "name": "sendmail-cf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "wrangler dev --config wrangler.dev.jsonc --local --ip 127.0.0.1 --port 8787",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.mjs",
    "build": "wrangler deploy --dry-run --outdir .build",
    "deploy": "bash scripts/deploy.sh",
    "deploy:worker": "bash scripts/deploy.sh --worker-only",
    "deploy:diagnose": "node scripts/diagnose-deploy.mjs",
    "deploy:check": "node scripts/deploy.mjs --check"
  },
  "devDependencies": { "wrangler": "4.95.0" }
}
