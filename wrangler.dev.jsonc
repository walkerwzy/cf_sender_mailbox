{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sendmail-cf-local",
  "main": "src/dev-worker.js",
  "compatibility_date": "2026-11-04",
  "send_metrics": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": { "MAIL_FROM_NAME": "walker" },
  "ratelimits": [
    {
      "name": "SEND_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
