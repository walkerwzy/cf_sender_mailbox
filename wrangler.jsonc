{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sendmail-cf",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "MAIL_FROM_NAME": "walker",
    "LOGIN_MODE": "access",
    "ALLOWED_EMAILS": "admin@wzy.one,hi@wzy.one"
  },
  "ratelimits": [
    {
      "name": "SEND_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "OUTBOX_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
