# Copy to .env.deploy. Keep keys in this local file; do not paste them into chat.
# Requires an API token with Account / Workers Scripts / Edit,
# Account / Access: Apps and Policies / Edit, and Account / Account Settings / Read.
# Also grant Account / Access: Organizations, Identity Providers, and Groups / Edit.
# For automated Resend DNS setup: Zone / Zone / Read and Zone / DNS / Edit (wzy.one).
# For a custom domain, also grant Zone / Workers Routes / Edit.
CLOUDFLARE_API_TOKEN=
# Optional if the token has access to exactly one Cloudflare account.
CLOUDFLARE_ACCOUNT_ID=
# Optional: discovered from the existing Zero Trust organization.
ACCESS_TEAM_DOMAIN=
ALLOWED_EMAILS=admin@wzy.one,hi@wzy.one
MAIL_FROM_NAME=walker
RESEND_API_KEY=
# Optional: Full access key for domain setup and outbox reading.
# Reused as the Worker's read secret unless RESEND_READ_API_KEY is set.
RESEND_ADMIN_API_KEY=
# Optional: override the outbox key (Full access).
# Read priority: RESEND_READ_API_KEY > RESEND_ADMIN_API_KEY > RESEND_API_KEY.
RESEND_READ_API_KEY=
# Public page hostname. Leave empty to use the account's workers.dev subdomain.
APP_DOMAIN=mail.wzy.one
# Optional: enable password + Beijing MMDD and email-code login together.
# The actual daily password is this exact prefix followed by four date digits.
LOGIN_PASSWORD=
# Optional: generated and persisted in .deploy/session-secret when omitted.
SESSION_SECRET=
# Optional: enable traditional attachments and download links using an existing or new R2 bucket.
# Public buckets are supported; uploads use attachment/. Existing public domains are kept.
# Non-empty environment variables override this file (e.g. R2_BUCKET_NAME=tmpfile npm run deploy:worker).
# Enable R2 in Cloudflare first. Deployment token also needs Account / Workers R2 Storage / Edit.
# deploy and deploy:worker create/check the bucket, CORS and attachment/ 10-day cleanup rule.
R2_BUCKET_NAME=
# R2 credentials: select the account, then Manage Account / Account API Tokens (left sidebar).
# Create R2 Object Read & Write credentials scoped to this bucket.
# These are the S3 Access Key ID / Secret Access Key, not CLOUDFLARE_API_TOKEN.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
